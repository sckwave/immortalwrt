#!/bin/sh
# 99-switch-rootfs - last modules-boot.d script to switch rootfs to a USB drive
# Placed in files/etc/modules-boot.d/ so it will be included in the generated image
# This script is intended to run in the initramfs stage (modules-boot.d). It will
# wait up to $TIMEOUT seconds for a USB block device, try to mount it and then
# switch_root to it (using /sbin/switch_root if available).

TIMEOUT=30
MOUNTPOINT=/mnt/usbroot
LABELS="ROOTFS rootfs USBROOT USBDATA" # labels to try in /dev/disk/by-label

set -e
log() { echo "[99-switch-rootfs] $*" >/dev/kmsg 2>/dev/null || echo "[99-switch-rootfs] $*"; }

end=$((SECONDS + TIMEOUT))
DEV=""

log "waiting up to $TIMEOUT s for USB root device"
while [ $SECONDS -lt $end ]; do
  # try labels first
  for L in $LABELS; do
    if [ -e "/dev/disk/by-label/$L" ]; then
      DEV=$(readlink -f "/dev/disk/by-label/$L")
      log "found by-label $L -> $DEV"
      break 2
    fi
  done

  # fallback: find first sdX* partition with a known fstype
  for d in /dev/sd[a-z][0-9]*; do
    [ -b "$d" ] || continue
    f=$(blkid -o value -s TYPE "$d" 2>/dev/null || true)
    case "$f" in
      ext4|f2fs|btrfs|squashfs)
        DEV="$d"
        log "found candidate $DEV (fstype=$f)"
        break 2
        ;;
    esac
  done

  sleep 1
done

if [ -z "$DEV" ]; then
  log "no suitable USB device found, skipping"
  exit 0
fi

log "attempting to mount $DEV -> $MOUNTPOINT"
mkdir -p "$MOUNTPOINT"
if ! mount -o ro "$DEV" "$MOUNTPOINT" >/dev/null 2>&1; then
  if ! mount "$DEV" "$MOUNTPOINT" >/dev/null 2>&1; then
    log "mount failed for $DEV"
    exit 1
  fi
fi

# Basic sanity checks for a rootfs
if [ ! -e "$MOUNTPOINT/sbin/init" ] && [ ! -e "$MOUNTPOINT/bin/busybox" ]; then
  log "no init or busybox found on $DEV, aborting"
  umount "$MOUNTPOINT" || true
  exit 1
fi

# Prefer /sbin/switch_root if available (OpenWrt initramfs provides it)
if [ -x /sbin/switch_root ]; then
  log "using /sbin/switch_root to hand off to USB rootfs"
  exec /sbin/switch_root "$MOUNTPOINT" /sbin/init
fi

# Fallback: try pivot_root + exec /sbin/init inside new root
# Mount necessary pseudo-filesystems if possible
log "/sbin/switch_root not available, trying pivot_root fallback"
mount -t proc proc "$MOUNTPOINT/proc" >/dev/null 2>&1 || true
mount -t sysfs sys "$MOUNTPOINT/sys" >/dev/null 2>&1 || true
mount -t devtmpfs dev "$MOUNTPOINT/dev" >/dev/null 2>&1 || true

cd "$MOUNTPOINT"
if command -v pivot_root >/dev/null 2>&1; then
  # create an empty dir to hold old root
  mkdir -p old_root
  if pivot_root . old_root >/dev/null 2>&1; then
    log "pivot_root succeeded, executing new init"
    exec chroot . /sbin/init
  else
    log "pivot_root failed"
    umount "$MOUNTPOINT" || true
    exit 1
  fi
else
  log "no pivot_root available, cannot switch root"
  umount "$MOUNTPOINT" || true
  exit 1
fi
